{
  "name": "oakline-medical-group",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": "22.x" },
  "scripts": {
    "images": "node scripts/images.mjs",
    "seo:gen": "node scripts/seo-gen.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/images.mjs && node scripts/seo-gen.mjs",
    "build": "next build && node scripts/image-audit.mjs http://localhost --static-only --out reports/image-audit-static.json",
    "audit:images": "node scripts/image-audit.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "check:links": "node scripts/check-links.mjs",
    "check:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2"
  }
}
